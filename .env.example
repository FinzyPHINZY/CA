# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development

# ==========================================
# Service Ports
# ==========================================
CORE_PORT=3000
AUTH_PORT=3001
AI_SERVICE_PORT=3002
NOTIFICATIONS_SERVICE_PORT=3003
NOTIFICATIONS_TCP_PORT=4004
FILE_SERVICE_PORT=3004
AUTH_SERVICE_TCP_PORT=4001

# ==========================================
# Database Configuration (Local Development)
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=acr_db
DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=true
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# PostgreSQL Container Configuration (Docker Compose)
# ==========================================
POSTGRES_DB=acr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ==========================================
# RabbitMQ Configuration
# ==========================================
RABBITMQ_URL=amqp://rabbitmq:5672
NOTIFICATIONS_QUEUE=notifications.queue
AI_SERVICE_QUEUE=ai_service.queue
CORE_SERVICE_QUEUE=core_service.queue

# ==========================================
# Service Communication
# ==========================================
AUTH_SERVICE_HOST=auth_service

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=refresh-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# Google OAuth Configuration
# ==========================================
GOOGLE_CLIENT_ID=524876179312-s7t6l1q8122rmg35vt5u1q7nc7brc9iv.apps.googleusercontent.com

