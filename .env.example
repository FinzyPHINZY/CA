# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==========================================
# Adobe PDF Extract (External PDF pipeline)
# ==========================================
USE_EXTERNAL_PDF_EXTRACTOR=false
EXTERNAL_PDF_EXTRACTOR_ROLLOUT=100
ADOBE_PDF_CLIENT_ID=
ADOBE_PDF_CLIENT_SECRET=
ADOBE_PDF_BASE_URL=https://pdf-services.adobe.io
ADOBE_PDF_SCOPES=openid,AdobeID,DCAPI

# ==========================================
# Google Document AI (External PDF fallback)
# ==========================================
GOOGLE_DOC_AI_PROJECT_ID=
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-docai-service-account.json

# ==========================================
# Debug utilities
# ==========================================
ENABLE_DEBUG_EXTRACTOR=false
SKIP_SCRIPT_VALIDATION=false

# ==========================================
# Hazel AI rehearsal
# ==========================================
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# Deepgram model. `nova-2` is the long-standing default and uses the
# legacy `keywords:boost` term-boosting param. `nova-3` is newer (better
# accuracy on accented English) and uses the higher-precision `keyterm`
# param. Flag-controlled rollout — flip to nova-3 after staging A/B.
DEEPGRAM_MODEL=nova-2
# Milliseconds of silence Deepgram waits before emitting an is_final event.
# 300ms matches conversational-AI industry standard. Raise to 500-800 if
# is_final fires on natural mid-sentence pauses; lower (200) to trim
# latency at the cost of more interim revisions.
DEEPGRAM_ENDPOINTING_MS=300
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_turbo_v2_5
HAZEL_MAX_SESSION_HOURS=4
HAZEL_DISCONNECT_GRACE_SECONDS=300
HAZEL_PREGEN_CONCURRENCY=5
HAZEL_NEUTRAL_VOICE_ID=
HAZEL_SILENCE_THRESHOLD_MS=2500
HAZEL_STALE_MATCH_THRESHOLD_MS=1200
HAZEL_SILENCE_MIN_MATCH_RATIO=0.4
HAZEL_STALE_MATCH_MIN_RATIO=0.35
HAZEL_SILENCE_PER_WORD_MS=150
HAZEL_SILENCE_MAX_MS=15000
HAZEL_STALE_MAX_MS=8000

# ==========================================
# CI Configuration
# ==========================================
CI=true

