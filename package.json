    "test:e2e": "jest --config ./apps/core/test/jest-e2e.json",
    "script-analysis:capture": "node scripts/capture-script-analysis-snapshot.js",
    "script-analysis:regression": "node -r ts-node/register scripts/run-script-analysis-regression.js",
    "backfill:user-role-fk": "node scripts/backfill-user-role-fk.js",
    "seed:super-admin": "node scripts/seed-super-admin.js",
    "script-qa:backfill": "node scripts/script-qa-backfill.js",
