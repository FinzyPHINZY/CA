    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:script-analysis": "jest --runInBand apps/ai_service/test/script-analysis-regression.util.spec.ts apps/core/src/modules/script/script-analysis-lifecycle.util.spec.ts apps/core/src/modules/project/project-analysis-summary.util.spec.ts",
    "test:admin": "node --max-old-space-size=8192 ./node_modules/jest/bin/jest.js --config ./jest.admin.config.js --runInBand",
    "test:admin:unit": "node --max-old-space-size=8192 ./node_modules/jest/bin/jest.js --config ./jest.admin.config.js --runInBand --testPathIgnorePatterns=e2e-spec",
